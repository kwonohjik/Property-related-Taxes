# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.local.example

# git worktree 동시작업 보조 파일 (scripts/wt-new.sh)
.wt-ports

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 법령 조문 API 응답 캐시 (7일 TTL, 로컬 전용)
.legal-cache/

# 법령 검증 실행 로그 (로컬 전용)
logs/

# Playwright E2E 산출물 (스크린샷·비디오·trace — 로컬 전용)
/scripts/e2e-artifacts/
/scripts/e2e-artifacts-edge/
/scripts/e2e-artifacts-deep/
/scripts/e2e-artifacts-p0p1/
/test-results/
/playwright-report/

# bkit 시스템 파일 (로컬 개발 환경 전용)
.bkit/

# Claude Code 로컬 설정 (개인별 커스터마이제이션)
.claude/settings.local.json

# 영농상속공제 거주지 매트릭스 — 원본 데이터 (commit 금지, 공공누리 1유형이지만 50MB+ 부담)
/data/raw/*
!/data/raw/.gitkeep

# 상가·오피스텔 기준시가 변환 산출물 (build:stdprice) — 파티션 gzip ≈255MB + manifest.
# 전부 빌드 산출물이므로 manifest도 커밋하지 않는다(클론 환경에 없는 데이터를 있다고 기술하는 모순 방지).
# 원본은 /data/raw/ 규약을 따른다. 설계: docs/02-design/features/commercial-officetel-standard-price-lookup.engine.design.md
/data/stdprice/

# lib/geo/*.bak — parse-koedb-txt.ts 자동 백업
/lib/geo/*.bak

# Playwright E2E 산출물 (스크린샷 등)
e2e/_artifacts/

