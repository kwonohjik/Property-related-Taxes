# ────────────────────────────────────────────────
# KoreanTaxCalc — 환경변수 예시
# 실키는 `.env.local` 에 입력 (gitignore — 절대 커밋 금지)
# ────────────────────────────────────────────────

# Supabase (필요 시)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 법제처 Open API (법령 리서치 — /law)
KOREAN_LAW_OC=

# Vworld (개별공시지가 조회)
NEXT_PUBLIC_VWORLD_KEY=

# 키움증권 OpenAPI (주식 자동조회)
#   https://openapi.kiwoom.com — 회원가입 후 앱키 발급
#   본 PR scope: 양도일 직전 1개월 종가 자동조회 (§99①3 · 시행령 §165③ 준용)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ENV=mock
# KIWOOM_ENV: "mock" (모의투자) | "prod" (실투자)
