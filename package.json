{
  "name": "korean-tax-calc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:transfer": "vitest run transfer multi-house non-business rental new-housing self-farming expropriation pre-1990 bundled multi-parcel exchange",
    "test:acquisition": "vitest run acquisition",
    "test:property": "vitest run property-tax property-object property-house property-land property-taxpayer property-exemption property-comprehensive separate",
    "test:comprehensive": "vitest run comprehensive five-year-cumulative",
    "test:inheritance": "vitest run inheritance property-valuation",
    "test:gift": "vitest run gift property-valuation",
    "seed:tax-rates": "tsx --env-file=.env.local scripts/seed-transfer-tax-rates.ts && tsx --env-file=.env.local scripts/seed-transfer-tax-rates-historical.ts",
    "seed:tax-rates:historical": "tsx --env-file=.env.local scripts/seed-transfer-tax-rates-historical.ts",
    "verify:legal": "tsx --env-file=.env.local scripts/verify-legal-codes.ts",
    "verify:legal:refresh": "tsx --env-file=.env.local scripts/verify-legal-codes.ts --clear",
    "check:legal-coverage": "tsx scripts/check-legal-coverage.ts",
    "build:sigungu": "tsx scripts/parse-koedb-txt.ts",
    "build:adjacency": "tsx scripts/build-adjacency-matrix.ts",
    "build:admin-data": "tsx scripts/download-admin-data.ts",
    "verify:matrix": "tsx scripts/verify-matrix.ts",
    "build:admin-all": "npm run build:sigungu && npm run build:adjacency && npm run verify:matrix",
    "typecheck": "tsc --noEmit",
    "check:pre-pr": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.48.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@turf/turf": "^7.3.5",
    "@types/adm-zip": "^0.5.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shapefile": "^0.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "adm-zip": "^0.5.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "husky": "^9.1.7",
    "iconv-lite": "^0.7.2",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
